{
  "name": "cloudissue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "网页版任务看板 Issue Board - 五列看板 / 拖拽流转 / 失败原因必填 / MySQL + MCP 持久化",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "mcp": "node mcp-server/index.js",
    "test": "node tests/integration.mjs",
    "test:mcp": "node tests/mcp-smoke.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
