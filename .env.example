# ---- MySQL 连接配置 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=issue
DB_PASSWORD=issue_pass
DB_NAME=issue_board
# docker compose 的 MySQL 容器使用（root 口令，请改为强口令）
MYSQL_ROOT_PASSWORD=change-me-root-pass
# MySQL 端口在宿主机的绑定地址；默认仅回环，需外部直连时改为 3306:3306
MYSQL_PUBLISH=127.0.0.1:3306

# ---- 认证 ----
# 必填，至少 16 位。生成方式：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=7d
# HTTPS 部署时设为 true（cookie 加 secure 标记）
COOKIE_SECURE=false

# ---- HTTP 服务 ----
PORT=5173
# 日志级别：fatal/error/warn/info/debug/trace
LOG_LEVEL=info
# 反向代理（nginx 等）后部署时设为 true，限流按真实客户端 IP 计数
TRUST_PROXY=false
# 限流阈值（每分钟全局 API 数 / 每 15 分钟认证尝试数）；跑集成测试时调高
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
